<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- Override price element in 2x7 label template          -->
    <!-- ===================================================== -->
    <template id="label_price_with_tax_2x7" inherit_id="product.report_simple_label2x7">
        <xpath expr="//strong[contains(@class, 'o_label_price')]" position="replace">
            <t t-set="_base_price" t-value="pricelist._get_product_price(product, 1, currency=pricelist.currency_id or product.currency_id)"/>
            <t t-set="_taxed_price" t-value="price_with_tax_by_product.get(product.id, _base_price)"/>
            <strong class="o_label_price" t-out="_taxed_price"
                t-options="{'widget': 'monetary', 'display_currency': pricelist.currency_id or product.currency_id, 'label_price': True}"/>
        </xpath>
    </template>

    <!-- ===================================================== -->
    <!-- Override price element in 4x7 label template          -->
    <!-- ===================================================== -->
    <template id="label_price_with_tax_4x7" inherit_id="product.report_simple_label4x7">
        <xpath expr="//strong[contains(@class, 'o_label_price_medium')]" position="replace">
            <t t-set="_base_price" t-value="pricelist._get_product_price(product, 1, currency=pricelist.currency_id or product.currency_id)"/>
            <t t-set="_taxed_price" t-value="price_with_tax_by_product.get(product.id, _base_price)"/>
            <strong class="o_label_price_medium" t-out="_taxed_price"
                t-options="{'widget': 'monetary', 'display_currency': pricelist.currency_id or product.currency_id, 'label_price': True}"/>
        </xpath>
    </template>

    <!-- ===================================================== -->
    <!-- Override price element in 4x12 label template         -->
    <!-- ===================================================== -->
    <template id="label_price_with_tax_4x12" inherit_id="product.report_simple_label4x12">
        <xpath expr="//div[contains(@class, 'o_label_price_medium')]/strong" position="replace">
            <t t-set="_base_price" t-value="pricelist._get_product_price(product, 1, currency=pricelist.currency_id or product.currency_id)"/>
            <t t-set="_taxed_price" t-value="price_with_tax_by_product.get(product.id, _base_price)"/>
            <strong t-out="_taxed_price"
                t-options="{'widget': 'monetary', 'display_currency': pricelist.currency_id or product.currency_id, 'label_price': True}"/>
        </xpath>
    </template>

    <!-- ===================================================== -->
    <!-- Override price element in Dymo label template         -->
    <!-- ===================================================== -->
    <template id="label_price_with_tax_dymo" inherit_id="product.report_simple_label_dymo">
        <xpath expr="//strong[contains(@class, 'o_label_price_small')]" position="replace">
            <t t-set="_base_price" t-value="pricelist._get_product_price(product, 1, currency=pricelist.currency_id or product.currency_id)"/>
            <t t-set="_taxed_price" t-value="price_with_tax_by_product.get(product.id, _base_price)"/>
            <strong class="o_label_price_small" t-out="_taxed_price"
                t-options="{'widget': 'monetary', 'display_currency': pricelist.currency_id or product.currency_id, 'label_price': True}"/>
        </xpath>
    </template>

    <!-- ===================================================== -->
    <!-- Override price computation in ZPL label template      -->
    <!-- ===================================================== -->
    <template id="label_price_with_tax_zpl" inherit_id="stock.label_product_product_view">
        <xpath expr="//t[@t-set='price_unformatted']" position="replace">
            <t t-set="_base_price" t-value="pricelist._get_product_price(product, 1)"/>
            <t t-set="_taxed_price_zpl" t-value="price_with_tax_by_product.get(product.id, _base_price)"/>
            <t t-set="price_unformatted" t-value="_taxed_price_zpl"/>
        </xpath>
        <xpath expr="//t[@t-set='price'][1]" position="replace">
            <t t-set="price" t-value="currency_id.format(_taxed_price_zpl)"/>
        </xpath>
    </template>

</odoo>
